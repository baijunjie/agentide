{
  "name": "@agentide/agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@agentide/agent-codex": "workspace:*",
    "@agentide/agent-core": "workspace:*",
    "@agentide/protocol": "workspace:*",
    "@agentide/shared-types": "workspace:*",
    "ws": "^8.21.3"
  },
  "scripts": {
    "build": "tsc -b && pnpm build:native",
    "build:native": "mkdir -p dist/native && cc -Wall -Wextra -Werror native/file-access.c -o dist/native/file-access",
    "check": "tsc -b --pretty false",
    "pretest": "pnpm build:native",
    "start": "node dist/main.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
