{
  "name": "agentide",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "check:swift": "swift test --package-path packages/client-protocol-swift",
    "check:macos": "xcodebuild -project apps/macos/AgentIDEMac.xcodeproj -scheme AgentIDEMac -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO build",
    "check:ios": "xcodebuild -project apps/ios/AgentIDEiOS.xcodeproj -scheme AgentIDEiOS -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "ajv": "8.17.1",
    "typescript": "5.9.2"
  }
}
